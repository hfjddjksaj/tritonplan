# TritonPlan production Caddy config. Caddy obtains and renews the TLS
# certificates itself (no CDN in front). Installed to /etc/caddy/Caddyfile by
# provision.sh.
#
# Deliberately NO Cross-Origin-Opener-Policy header: COOP would sever
# window.opener, which the localStorage migration from the old site relies on.
tritonplan.cn {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Real-IP {remote_host}
		}
	}
	# Hashed assets: a missing one must 404, not fall back to index.html with a
	# one-year immutable header (so no try_files here).
	handle /assets/* {
		root * /srv/tritonplan/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/tritonplan/web
		# Everything that is not a hashed asset must revalidate. `header` runs
		# before the try_files rewrite, so a matcher like `path / /index.html`
		# would never match SPA routes such as /reset or /migrate: they would be
		# heuristically cached and keep pointing at hashed assets that a later
		# deploy removed.
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
www.tritonplan.cn {
	redir https://tritonplan.cn{uri} permanent
}
