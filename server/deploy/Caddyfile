# TritonPlan production Caddy config. Caddy obtains and renews the TLS
# certificates itself (no CDN in front). Installed to /etc/caddy/Caddyfile by
# provision.sh.
#
# Deliberately NO Cross-Origin-Opener-Policy header: COOP would sever
# window.opener, which the localStorage migration from the old site relies on.
tritonplan.cn {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	# What a page may load and run: only this site's own files. If a script is
	# ever injected into a page, the browser refuses to run it or to send data to
	# another host. For everything served from disk; the API sets a stricter one
	# of its own. Report-Only: the browser only logs what it would have refused
	# (in its console), until the planner has been seen to run clean under it.
	# 'unsafe-inline' is for styles only (privacy.html has a <style> block);
	# data: and blob: images are the icons in the CSS and the map's own.
	@pages not path /api/*
	header @pages Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	handle /api/* {
		# Just above the app's own 8 MB /api/sync cap: an oversized body is
		# refused here before it reaches Node at all.
		request_body {
			max_size 9MB
		}
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Real-IP {remote_host}
		}
	}
	# Hashed assets: a missing one must 404, not fall back to index.html (so no
	# try_files here), and the 404 must not carry the one-year immutable header
	# either, or a browser could keep it for a chunk a later deploy does ship.
	handle /assets/* {
		root * /srv/tritonplan/web
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/tritonplan/web
		# Everything that is not a hashed asset must revalidate. `header` runs
		# before the try_files rewrite, so a matcher like `path / /index.html`
		# would never match SPA routes such as /reset or /migrate: they would be
		# heuristically cached and keep pointing at hashed assets that a later
		# deploy removed.
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
www.tritonplan.cn {
	redir https://tritonplan.cn{uri} permanent
}
