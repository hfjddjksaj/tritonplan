# TritonPlan server environment. provision.sh copies this to
# /etc/tritonplan/env ONLY if that file does not exist yet.
# Fill the empty secrets by hand in the Tencent console web terminal
# (nano /etc/tritonplan/env), then: systemctl restart tritonplan
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell expansion.
# Values with spaces or <> are wrapped in double quotes (systemd strips them).
TP_PORT=8787
TP_HOST=127.0.0.1
TP_ORIGIN=https://tritonplan.cn
TP_DB_PATH=/srv/tritonplan/data/tritonplan.db
TP_MAIL_TRANSPORT=resend
TP_MAIL_FROM="TritonPlan <noreply@tritonplan.cn>"
# Monthly RateMyProfessors roster download; only the literal "off" disables it.
TP_RMP_REFRESH=on
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
